{
  "name": "simora-vercel-sql",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types scripts/migrate.ts",
    "db:admin": "node --env-file=.env.local --experimental-strip-types scripts/create-admin.ts",
    "db:seed": "node --env-file=.env.local --experimental-strip-types scripts/seed.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "jsqr": "^1.4.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/pg": "^8.15.6",
    "@electric-sql/pglite": "^0.3.14"
  }
